          "name": "Get a list of forms",
          "request": {
            "name": "Get a list of forms",
            "description": {
              "content": "Returns a paginated list of form instances the caller has access to. Supports filtering and sorting via query parameters.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "forms"
